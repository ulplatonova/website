# CleanHub: настройки сервера личного кабинета. Скопируйте в .env (или задайте в окружении контейнера).
# Реальные значения нигде не храните в git.

# --- Сервер ---
# Порт HTTP
PORT=8080
# Публичный адрес этого API (без / на конце)
PUBLIC_URL=https://api.cleanhub24.ru/lk
# Адрес страницы кабинета (кнопки в Telegram-боте и возврат после оплаты)
CABINET_URL=https://cleanhub24.ru/lk
# Адрес сайта: из него собирается реферальная ссылка ?ref=CH-XXXXX
SITE_URL=https://cleanhub24.ru
# Разрешённые origin для CORS через запятую (страница кабинета на Тильде)
ALLOWED_ORIGINS=https://cleanhub24.ru,https://www.cleanhub24.ru
# 1, если сервер стоит за reverse proxy (nginx/Caddy): IP клиента берётся из X-Forwarded-For
TRUST_PROXY=1
# Файл SQLite. Резервируйте его вместе с файлами -wal и -shm (см. README)
DB_PATH=./data/lk.sqlite
# error | warn | info
LOG_LEVEL=info

# --- Битрикс24 ---
# ОБЯЗАТЕЛЬНО. Входящий вебхук с правом «CRM»: https://<портал>.bitrix24.ru/rest/<id пользователя>/<токен>/
BITRIX_WEBHOOK_URL=
# application_token исходящего вебхука (события ONCRMDEALUPDATE/ONCRMDEALADD). Если пусто, /bitrix/events отвечает 403
BITRIX_EVENT_TOKEN=
# Воронка, в которой создаются заказы (0 — основная)
BITRIX_CATEGORY_ID=0
# Стадия новых заказов. Для не основной воронки с префиксом, например C2:NEW
BITRIX_STAGE_NEW=NEW
# Стадии «в работе» (сравниваются по части после «:»)
BITRIX_WORK_STAGES=EXECUTING,PREPARATION
# Ответственный за новые сделки и контакты (ID пользователя Битрикса), 0 — по умолчанию
BITRIX_ASSIGNED_BY_ID=0
# Пауза перед первым повтором запроса при ошибках 5xx/QUERY_LIMIT_EXCEEDED, мс (дальше удваивается)
BITRIX_RETRY_BASE_MS=500
# Необязательно: свои имена пользовательских полей, если не подходят UF_CRM_CH_*
# BITRIX_FIELD_SERVICE=UF_CRM_CH_SERVICE
# BITRIX_FIELD_TARIFF=UF_CRM_CH_TARIFF
# BITRIX_FIELD_AREA=UF_CRM_CH_AREA
# BITRIX_FIELD_ADDRESS=UF_CRM_CH_ADDRESS
# BITRIX_FIELD_SLOT=UF_CRM_CH_SLOT
# BITRIX_FIELD_VISIT_DATE=UF_CRM_CH_VISIT_DATE
# BITRIX_FIELD_BONUS_SPENT=UF_CRM_CH_BONUS_SPENT
# BITRIX_FIELD_EXTRAS=UF_CRM_CH_EXTRAS
# BITRIX_FIELD_SUB_ID=UF_CRM_CH_SUB_ID
# BITRIX_FIELD_REF_CODE=UF_CRM_CH_REFCODE

# --- SMS ---
# console — код пишется в лог (ТОЛЬКО для разработки), smsru — sms.ru (не проверено на живом сервисе)
SMS_PROVIDER=smsru
SMSRU_API_ID=

# --- Администрирование ---
# Ключ для POST /internal/materialize (заголовок X-Admin-Key). Длинная случайная строка. Если пусто, ручка закрыта
ADMIN_KEY=

# --- Бонусы ---
REFERRAL_OWNER_BONUS=500
REFERRAL_FRIEND_BONUS=500
# Какую часть заказа можно оплатить бонусами, %
MAX_PAY_PERCENT=30

# --- Подписки ---
# Как часто создавать сделки на ближайшие визиты, минут (0 — не создавать, использовать cron)
MATERIALIZE_INTERVAL_MIN=60

# --- Платежи ---
# none — подписка сразу активна; yookassa — оплата первого месяца через ЮKassa (НЕ ПРОВЕРЕНО на реальном API)
PAYMENTS_PROVIDER=none
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Имя бота без @
TELEGRAM_BOT_USERNAME=
# Секрет для setWebhook (secret_token): 1-256 символов A-Z a-z 0-9 _ -. Если пусто, вебхук бота закрыт
TELEGRAM_WEBHOOK_SECRET=
